# ==============================================================================
# Gyanvatsala - Clean Production .gitignore for Vercel & Render
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secret Credentials (CRITICAL - NEVER COMMIT)
# ------------------------------------------------------------------------------
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
credentials.json
service-account*.json
# Allow example template only
!.env.example

# ------------------------------------------------------------------------------
# 2. Dependencies
# ------------------------------------------------------------------------------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ------------------------------------------------------------------------------
# 3. Next.js & Frontend Build Outputs
# ------------------------------------------------------------------------------
/.next/
/out/
/build
/dist
.vercel
*.tsbuildinfo
next-env.d.ts

# ------------------------------------------------------------------------------
# 4. Python, Celery & Backend Artifacts
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/__pycache__/
backend/*/__pycache__/
backend/*/*/__pycache__/
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
ENV/
env/
backend/.venv/
celerybeat-schedule
celerybeat.pid
*.sqlite3

# ------------------------------------------------------------------------------
# 5. OS & Editor Artifacts
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ------------------------------------------------------------------------------
# 6. Logs & Temp Artifacts
# ------------------------------------------------------------------------------
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
tmp/
temp/
scratch/
