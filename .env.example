# ==============================================================================
# Gyanvatsala - Your Digital Document Workspace Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application URLs
# ------------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Backend API URL (e.g. Render deployment URL in production)
BACKEND_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 2. Database (Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 3. Object Storage (S3 / Cloudflare R2 / Neon Storage)
# ------------------------------------------------------------------------------
AWS_ENDPOINT_URL_S3=https://your-storage-endpoint.com
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-2
AWS_S3_BUCKET=gyanvatsala-storage

# ------------------------------------------------------------------------------
# 4. Authentication (Better Auth & Google OAuth)
# ------------------------------------------------------------------------------
BETTER_AUTH_SECRET=your_32_characters_random_secret_key_here
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ------------------------------------------------------------------------------
# 5. Transactional Email (Resend)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="Gyanvatsala Security <fileprocess@gyanvatsala.in>"
