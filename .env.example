# ==============================================================================
# PixelKit SaaS Platform - Environment Configuration Template
# ==============================================================================

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 1. Database Configuration (Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
# Pooled connection string (for high-concurrency API server and Next.js serverless functions)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/pixelkit?sslmode=require&pgbouncer=true
# Direct unpooled connection string (required for DDL migrations)
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/pixelkit?sslmode=require

# ------------------------------------------------------------------------------
# 2. Authentication (Better Auth)
# ------------------------------------------------------------------------------
# Run `openssl rand -base64 32` to generate a secure secret
BETTER_AUTH_SECRET=pixelkit_production_super_secret_auth_token_key_change_me_32chars
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth Credentials (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# Transactional Email (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=PixelKit Security <no-reply@pixelkit.app>

# ------------------------------------------------------------------------------
# 3. AWS S3 Storage Architecture (Private Buckets & Presigned URLs)
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=us-east-1
AWS_S3_BUCKET=pixelkit-production-storage
S3_PRESIGNED_URL_EXPIRES_SECONDS=900
S3_MULTIPART_MIN_CHUNK_SIZE_MB=5

# ------------------------------------------------------------------------------
# 4. Background Processing & Queues (Redis + Celery)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_WORKER_CONCURRENCY=4

# ------------------------------------------------------------------------------
# 5. SaaS Subscription & Storage Quota Defaults
# ------------------------------------------------------------------------------
DEFAULT_STORAGE_LIMIT_BYTES=524288000        # 500 MB (Free Tier)
DEFAULT_MAX_FILE_SIZE_BYTES=52428800        # 50 MB
PRO_STORAGE_LIMIT_BYTES=26843545600         # 25 GB (Pro Tier)
PRO_MAX_FILE_SIZE_BYTES=1073741824          # 1 GB
BUSINESS_STORAGE_LIMIT_BYTES=107374182400   # 100 GB (Business Tier)
BUSINESS_MAX_FILE_SIZE_BYTES=5368709120     # 5 GB
